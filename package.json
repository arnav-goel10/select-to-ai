{
  "name": "select-to-ai-extension",
  "version": "4.0.0",
  "private": true,
  "description": "Privacy-first Chrome extension for sending selected text to AI assistants and running bounded browser workflows.",
  "scripts": {
    "check": "npm run check:fast && npm run check:browser",
    "check:fast": "npm run check:syntax && npm run check:manifest && npm test && npm run benchmark",
    "check:browser": "npm run test:extract && npm run test:scan && npm run test:widgets && npm run test:chatgpt && npm run test:v4 && npm run test:recipes-driver && npm run test:recipes-ext",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:manifest": "node scripts/validate-manifest.mjs",
    "test": "node --test tests/unit/*.test.js",
    "benchmark": "node tests/benchmark/security-benchmark.js",
    "package": "node scripts/package-extension.mjs",
    "eval:capture": "node tests/decisions/capture.js",
    "eval:decisions": "node tests/decisions/run-v4.js",
    "test:extract": "node tests/e2e/extract-layout.js",
    "eval:reading-wild": "node tests/reading/wild.js",
    "test:scan": "node tests/e2e/scan-structure.js",
    "eval:bench": "node tests/bench/run.js",
    "test:v4": "node tests/e2e/run-v4.js",
    "bench:split": "node tests/bench/split.js",
    "bench:matrix": "node tests/bench/matrix.js",
    "test:widgets": "node tests/e2e/widgets.js",
    "test:chatgpt": "node tests/e2e/chatgpt-capture.js",
    "bench:chatgpt-login": "node tests/bench/chatgpt-profile.js",
    "bench:recipes": "node bench/recipes/run.js",
    "test:recipes": "node --test tests/recipes/*.test.js",
    "build:recipes": "node scripts/build-recipes.mjs",
    "test:recipes-ext": "node tests/e2e/recipes-extension.js",
    "test:recipes-driver": "node --test tests/recipes/extension-driver.test.js tests/recipes/extension-recording.test.js",
    "test:first-run": "node tests/e2e/first-run.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@mozilla/readability": "^0.6.0",
    "healwright": "2.0.0",
    "playwright": "1.65.0",
    "puppeteer": "^25.7.0"
  }
}
