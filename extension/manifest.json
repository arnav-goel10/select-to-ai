{
  "manifest_version": 3,
  "name": "Select to AI",
  "short_name": "Select to AI",
  "description": "Send selected text to ChatGPT, Claude, Gemini or Perplexity, or ask an AI agent to read and use websites in your own browser.",
  "version": "4.0.0",
  "homepage_url": "https://github.com/arnav-goel10/select-to-ai",
  "minimum_chrome_version": "120",
  "offline_enabled": false,
  "incognito": "not_allowed",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Select to AI"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "contextMenus",
    "storage",
    "sidePanel",
    "tabs",
    "declarativeNetRequest",
    "activeTab",
    "scripting",
    "identity",
    "alarms",
    "idle"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "config.js",
        "contentScript.js"
      ],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon128.png"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "open-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open the side panel"
    },
    "run-agent": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "MacCtrl+Shift+G"
      },
      "description": "Open the agent"
    },
    "open-palette": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "MacCtrl+Shift+Q"
      },
      "description": "Open the quick box"
    }
  }
}
